# The runner wins when it names a target. r-universe sets CARGO_BUILD_TARGET to
# `aarch64-pc-windows-gnullvm` for the arm64 job, where $(WIN) is empty and the
# derivation below would produce a bare `-pc-windows-gnu`.
TARGET = $(if $(CARGO_BUILD_TARGET),$(CARGO_BUILD_TARGET),$(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu)

TARGET_DIR = @TARGET_DIR@
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libbixverse.a
PKG_LIBS = -L"$(LIBDIR)" -lbixverse @HDF5_LIBS@-lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = vendor

$(STATLIB):
	mkdir -p "$(TARGET_DIR)/libgcc_mock"
	touch "$(TARGET_DIR)/libgcc_mock/libgcc_eh.a"

  # If a vendor directory exists, it is used for offline compilation. Otherwise if
  # vendor.tar.xz exists, it is unzipped and used for offline compilation.
	if [ -d ./vendor ]; then \
		echo "=== Using offline vendor directory ==="; \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	elif [ -f ./rust/vendor.tar.xz ]; then \
		echo "=== Using offline vendor tarball ==="; \
		tar xf rust/vendor.tar.xz && \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	fi

	# Build the project using Cargo with additional flags
	export CARGO_HOME=@CARGO_HOME@ && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(TARGET_DIR)/libgcc_mock" && \
	@HDF5_EXPORTS@@DEV_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs@HDF5_RUSTFLAGS@" cargo build @CRAN_FLAGS@ @CARGO_FEATURES@ --target=$(TARGET) --lib @PROFILE@ --manifest-path=rust/Cargo.toml --target-dir="$(TARGET_DIR)"

	# Generate wrappers. The profile, RUSTFLAGS and the dev overrides all have to
	# match the build above, see Makevars.in.
	export CARGO_HOME=@CARGO_HOME@ && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	@HDF5_EXPORTS@@DEV_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs@HDF5_RUSTFLAGS@" cargo run @CRAN_FLAGS@ @CARGO_FEATURES@ @PROFILE@ --bin document --target $(TARGET) --manifest-path=./rust/Cargo.toml --target-dir "$(TARGET_DIR)"

	# Always clean up CARGOTMP
	rm -Rf $(CARGOTMP);

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) $(VENDOR_DIR) @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" $(VENDOR_DIR)
